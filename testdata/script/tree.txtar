# Root discovery, the walk, and `para path` against a hand-planted tree
# (§8.1, §8.5, §14). The tree is planted directly by this script rather than
# via `para init`, since init's full file set (README, AGENTS.md, ACTIVITY.md,
# rendering) is a later phase's job (§0.2, §26).

# para path resolves a locator from inside the tree, discovering the root by
# walking up from the working directory.
[para:phase4] cd brain/projects/acme-migration
[para:phase4] exec para path areas.health
[para:phase4] stdout 'brain[/\\]areas[/\\]health\n$'

# ... and from content nested arbitrarily deep inside an entity.
[para:phase4] cd $WORK/brain/areas/health/training/notes
[para:phase4] exec para path projects.acme-migration
[para:phase4] stdout 'brain[/\\]projects[/\\]acme-migration\n$'

# "." resolves to the entity or container containing the working directory.
[para:phase4] cd $WORK/brain/areas/health/training
[para:phase4] exec para path .
[para:phase4] stdout 'brain[/\\]areas[/\\]health[/\\]training\n$'

# ... including from inside a skill, crossing the .agents/ break (§8.1).
[para:phase4] cd $WORK/brain/.agents/skills/para-signups-report/scripts
[para:phase4] exec para path .
[para:phase4] stdout 'para-signups-report\n$'

# Root discovery fails outside any tree.
[para:phase4] cd $WORK/outside
[para:phase4] ! exec para path areas.health
[para:phase4] stderr 'no para tree found'

-- brain/.para/tree.toml --
schema = 1

-- brain/projects/.para/state.toml --
name = "Projects"

-- brain/projects/acme-migration/.para/state.toml --
name = "Acme migration"

-- brain/areas/.para/state.toml --
name = "Areas"

-- brain/areas/health/.para/state.toml --
name = "Health"

-- brain/areas/health/training/.para/state.toml --
name = "Training"

-- brain/areas/health/training/notes/plan.md --
just a file, not an entity

-- brain/.agents/skills/para-signups-report/.para/state.toml --
name = "Signups report"

-- brain/.agents/skills/para-signups-report/scripts/pull.sh --
#!/bin/sh

-- outside/.keep --
not a para tree
