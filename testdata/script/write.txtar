# §26's `para add`, `para set` / `unset`, and `para note` / `measure` blocks,
# against a hand-planted tree. The tree is planted by this script rather than by
# `para init`, whose full file set is a later phase's job (§0.1).
#
# Two departures from §26, both deliberate and both resolved the way Phase 7
# resolved the same disagreement:
#
#  - §26's `set` example prints only the change line, while §23 says mutations
#    print what they wrote, one line per file. The prose wins; the example is
#    showing the part it is about.
#  - §23's own `measure` example lists state.toml and README.md among the files
#    written. A key-result stores no `current`, `progress`, or derived status
#    (§2.5), so neither file can have changed and neither is rewritten. What a
#    mutation prints has to be what it actually wrote.

env PARA_NOW=2026-03-05T17:00:00Z
env PARA_TZ=America/Los_Angeles
[para:phase8] cd brain

# --- §26's `para add` block -------------------------------------------------

# A project, and its objectives/ container, in one operation (§18.1).
[para:phase8] exec para add projects.acme-migration --name 'Acme migration' --description 'Rebuild the consumer so it stops falling over under replay load.'
[para:phase8] cmp stdout $WORK/want-add-project.txt

# The new entity's journal starts empty; the parent logs `child added` (§3.3).
[para:phase8] ! exists projects/acme-migration/.para/logs/20260305T170000Z.jsonl
[para:phase8] exists projects/acme-migration/.para/logs
[para:phase8] grep '"kind":"child","op":"added","child":"acme-migration"' projects/.para/logs/20260305T170000Z.jsonl

# `created` is a field, not an event (§3.1) — and it still earns its line in the
# digest, so the file and `activity` agree by construction (§16.4).
[para:phase8] cmp projects/acme-migration/ACTIVITY.md $WORK/want-new-activity.txt
[para:phase8] cmp projects/acme-migration/.para/state.toml $WORK/want-project-state.txt

# README frontmatter is generated over a stub body para will never touch again
# (§2.1).
[para:phase8] cmp projects/acme-migration/README.md $WORK/want-project-readme.txt

# An objective — the parent must already exist; key-results/ comes with it.
[para:phase8] exec para add projects.acme-migration.objectives.q1-growth --name 'Grow signups' --description 'Move the top of the funnel.'
[para:phase8] exists projects/acme-migration/objectives/q1-growth/key-results/.para/state.toml

# A key-result — type is required and permanent.
[para:phase8] exec para add projects.acme-migration.objectives.q1-growth.key-results.signups --name 'Weekly signups' --type ratio --start 480/9000 --target 2000/12000 --due 2026-09-30
[para:phase8] cmp projects/acme-migration/objectives/q1-growth/key-results/signups/.para/state.toml $WORK/want-kr-state.txt

# A key-result is a leaf: no eager container comes with it.
[para:phase8] ! exists projects/acme-migration/objectives/q1-growth/key-results/signups/key-results

# Areas and resources nest freely.
[para:phase8] exec para add areas.health --name Health --description 'Staying in one piece.'
[para:phase8] exec para add areas.health.training --name Training --description 'The weekly plan.'
[para:phase8] exists areas/health/training/.para/state.toml

# A skill — scope is a locator list, and this also writes its derived rule.
[para:phase8] exec para add skills.signups-report --name 'Signups report' --description 'when asked for the weekly signups number' --scope projects.acme-migration,areas.growth
[para:phase8] cmp stdout $WORK/want-add-skill.txt
[para:phase8] cmp .agents/rules/para-signups-report.md $WORK/want-scoped-rule.txt

# A skill with no scope applies to the whole tree, and its rule says so (§5.3).
[para:phase8] exec para add skills.commit-style --name 'Commit style' --description 'when writing a commit message'
[para:phase8] grep '^Use the \*\*Commit style\*\* skill' .agents/rules/para-commit-style.md
[para:phase8] ! grep 'When working under' .agents/rules/para-commit-style.md

# §26's four refusals, each naming the problem.
[para:phase8] ! exec para add projects.acme-migration --name Again --description Again.
[para:phase8] stderr 'projects.acme-migration already exists'
[para:phase8] ! exec para add projects.acme-migration.nested --name A --description B
[para:phase8] stderr 'a project cannot nest'
[para:phase8] ! exec para add projects.objectives --name A --description B
[para:phase8] stderr 'reserved word'
[para:phase8] ! exec para add projects.acme-migration.objectives.q2.key-results.z --type ratio --name Z
[para:phase8] stderr 'projects.acme-migration.objectives.q2 does not exist'

# A field the kind does not have, and a missing required one.
[para:phase8] ! exec para add areas.finance --name Finance --description Money. --due 2026-09-30
[para:phase8] stderr 'an area has no due field'
[para:phase8] ! exec para add projects.other --name Other
[para:phase8] stderr 'project needs --description'

# --- §26's `para set` / `unset` block ---------------------------------------

# --note is required when setting status to blocked (§18.2).
[para:phase8] ! exec para set projects.acme-migration --status blocked
[para:phase8] stderr '^error: --note is required when setting status to blocked$'

[para:phase8] exec para set projects.acme-migration --status in-progress
[para:phase8] stdout '^projects.acme-migration  status planned → in-progress\n'

[para:phase8] exec para set projects.acme-migration --status blocked --note 'waiting on the ingest team'
[para:phase8] cmp stdout $WORK/want-set-blocked.txt

# Setting a field to the value it already holds writes nothing and exits 0, but
# the reason the user typed is still an act of attention (§15, §26).
[para:phase8] exec para set projects.acme-migration --status blocked --note 'still waiting'
[para:phase8] stdout '^no change \(status already blocked\); note recorded\n'
[para:phase8] grep '"kind":"note","note":"still waiting"' projects/acme-migration/.para/logs/20260305T170000Z.jsonl

# A pure no-op writes nothing at all — and note that --note is required for
# `blocked` before anything is compared, since the user is asserting the status
# whether or not it turns out to have moved (§18.2).
[para:phase8] exec para set projects.acme-migration --name 'Acme migration'
[para:phase8] cmp stdout $WORK/want-no-change.txt

# type is fixed at creation and can never be changed (§15).
[para:phase8] ! exec para set projects.acme-migration.objectives.q1-growth.key-results.signups --type number
[para:phase8] stderr 'type is fixed at creation'

# unset takes bare names; `created` is an error, and a required field is too.
[para:phase8] exec para set projects.acme-migration --due 2026-12-31 --priority high
[para:phase8] exec para unset projects.acme-migration due priority
[para:phase8] stdout '^projects.acme-migration  due unset \(was 2026-12-31\)\n'
[para:phase8] ! exec para unset projects.acme-migration created
[para:phase8] stderr 'created cannot be unset'
[para:phase8] ! exec para unset projects.acme-migration name
[para:phase8] stderr 'name is required'

# `unset skills.x scope` widens it back to the whole tree (§5.2, §15).
[para:phase8] exec para unset skills.signups-report scope
[para:phase8] ! grep 'When working under' .agents/rules/para-signups-report.md

# --- §26's `para note` / `measure` block ------------------------------------

[para:phase8] exec para note areas.health.training 'swapped the tempo block for intervals'
[para:phase8] grep 'Note: swapped the tempo block for intervals.' areas/health/training/ACTIVITY.md

# §26's measurement, with §4.2's arithmetic: start is subtracted from both
# sides, so 880/11000 against start 480/9000 and target 2000/12000 is 0.24.
[para:phase8] exec para measure projects.acme-migration.objectives.q1-growth.key-results.signups 880/11000 --at 2026-01-03
[para:phase8] cmp stdout $WORK/want-measured.txt
[para:phase8] cmp projects/acme-migration/objectives/q1-growth/key-results/signups/MEASUREMENTS.csv $WORK/want-measurements.txt

# The value follows the key-result's own type, and a mismatch names both.
[para:phase8] ! exec para measure projects.acme-migration.objectives.q1-growth.key-results.signups 0.08
[para:phase8] stderr 'value 0.08 is not a ratio \(type ratio expects <numerator>/<denominator>\)'

# Measurements are unique at the exact stored instant, not the day (§3.1).
[para:phase8] ! exec para measure projects.acme-migration.objectives.q1-growth.key-results.signups 900/11000 --at 2026-01-03
[para:phase8] stderr 'a measurement already exists at 2026-01-03T08:00:00Z \(2026-01-03T00:00:00-08:00 local\)'
[para:phase8] exec para measure projects.acme-migration.objectives.q1-growth.key-results.signups 900/11000 --at 2026-01-03T09:02

# Nothing may be dated into the future (§15.1).
[para:phase8] ! exec para note areas.health 'later'  --at 2027-01-01
[para:phase8] stderr 'in the future'

# Only a key-result takes measurements (§4.4: it lives there and nowhere else).
[para:phase8] ! exec para measure projects.acme-migration 10
[para:phase8] stderr 'only a key-result takes measurements'

# A mutation needs a tree.
[para:phase8] cd $WORK/outside
[para:phase8] ! exec para add projects.x --name X --description Y
[para:phase8] stderr 'no para tree found'

-- brain/.para/tree.toml --
schema = 1
name = "brain"

-- brain/README.md --
