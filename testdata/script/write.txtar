# §26's `para add`, `para set` / `unset`, and `para note` / `measure` blocks,
# against a hand-planted tree. The tree is planted by this script rather than by
# `para init`, whose full file set is a later phase's job (§0.1).
#
# Two departures from §26, both deliberate and both resolved the way Phase 7
# resolved the same disagreement:
#
#  - §26's `set` example prints only the change line, while §23 says mutations
#    print what they wrote, one line per file. The prose wins; the example is
#    showing the part it is about.
#  - §23's own `measure` example lists state.toml and README.md among the files
#    written. A key-result stores no `current`, `progress`, or derived status
#    (§2.5), so neither file can have changed and neither is rewritten. What a
#    mutation prints has to be what it actually wrote.

env PARA_NOW=2026-03-05T17:00:00Z
env PARA_TZ=America/Los_Angeles
cd brain

# --- §26's `para add` block -------------------------------------------------

# A project, and its objectives/ container, in one operation (§18.1).
exec para add project acme-migration --name 'Acme migration' --description 'Rebuild the consumer so it stops falling over under replay load.'
cmp stdout $WORK/want-add-project.txt

# The new entity's journal starts empty; the parent logs `child added` (§3.3).
! exists projects/acme-migration/.para/logs/20260305T170000Z.jsonl
exists projects/acme-migration/.para/logs
grep '"kind":"child","op":"added","child":"acme-migration"' projects/.para/logs/20260305T170000Z.jsonl

# `created` is a field, not an event (§3.1) — and it still earns its line in the
# digest, so the file and `activity` agree by construction (§16.4).
cmp projects/acme-migration/ACTIVITY.md $WORK/want-new-activity.txt
cmp projects/acme-migration/.para/state.toml $WORK/want-project-state.txt

# README frontmatter is generated over a stub body para will never touch again
# (§2.1).
cmp projects/acme-migration/README.md $WORK/want-project-readme.txt

# An objective — the parent must already exist; key-results/ comes with it.
exec para add objective acme-migration.q1-growth --name 'Grow signups' --description 'Move the top of the funnel.'
exists projects/acme-migration/objectives/q1-growth/key-results/.para/state.toml

# A key-result — type is required and permanent.
exec para add key-result acme-migration.q1-growth.signups --name 'Weekly signups' --type ratio --start 480/9000 --target 2000/12000 --due 2026-09-30
cmp projects/acme-migration/objectives/q1-growth/key-results/signups/.para/state.toml $WORK/want-kr-state.txt

# A key-result is a leaf: no eager container comes with it.
! exists projects/acme-migration/objectives/q1-growth/key-results/signups/key-results

# Areas and resources nest freely.
exec para add area health --name Health --description 'Staying in one piece.'
exec para add area health.training --name Training --description 'The weekly plan.'
exists areas/health/training/.para/state.toml

# A skill — scope is an address list, and this also writes its derived rule.
exec para add skill signups-report --name 'Signups report' --description 'when asked for the weekly signups number' --scope project.acme-migration,area.growth
cmp stdout $WORK/want-add-skill.txt
cmp .agents/rules/para-signups-report.md $WORK/want-scoped-rule.txt

# A skill with no scope applies to the whole tree, and its rule says so (§5.3).
exec para add skill commit-style --name 'Commit style' --description 'when writing a commit message'
grep '^Use the \*\*Commit style\*\* skill' .agents/rules/para-commit-style.md
! grep 'When working under' .agents/rules/para-commit-style.md

# §26's four prose refusals, each naming the problem, plus a fifth this task
# adds: a wrong-arity chain for a noun besides project's (P22.3).
! exec para add project acme-migration --name Again --description Again.
stderr 'project.acme-migration already exists'
! exec para add project acme-migration.nested --name A --description B
stderr 'project takes no chain \(the bucket\) or exactly one segment, not a chain of 2'
! exec para add project objectives --name A --description B
stderr 'reserved word'
! exec para add key-result acme-migration.q1-growth.launch --type ratio --name Launch
stderr 'key-result needs --target'

# The fifth: a wrong-arity chain for a noun besides project — objective takes
# exactly two segments, never three, and never a bucket (R4, R17: an
# objective has no bucket form to fall back to).
! exec para add objective acme-migration.q1-growth.extra --name X --description Y
stderr 'objective takes exactly two segments, not a chain of 3'

# A field the kind does not have is now an unknown flag — add's per-noun
# subcommand never registers it (P19.3) — rather than mutate's own runtime
# refusal; a missing required one is still mutate's (§15).
! exec para add area finance --name Finance --description Money. --due 2026-09-30
stderr 'unknown flag: --due'
! exec para add project other --name Other
stderr 'project needs --description'

# --- §26's `para set` / `unset` block ---------------------------------------

# --note is required when setting status to blocked (§18.2).
! exec para set project acme-migration --status blocked
stderr '^error: --note is required when setting status to blocked$'

exec para set project acme-migration --status in-progress
stdout '^project.acme-migration  status planned → in-progress\n'

exec para set project acme-migration --status blocked --note 'waiting on the ingest team'
cmp stdout $WORK/want-set-blocked.txt

# Setting a field to the value it already holds writes nothing and exits 0, but
# the reason the user typed is still an act of attention (§15, §26).
exec para set project acme-migration --status blocked --note 'still waiting'
stdout '^no change \(status already blocked\); note recorded\n'
grep '"kind":"note","note":"still waiting"' projects/acme-migration/.para/logs/20260305T170000Z.jsonl

# A pure no-op writes nothing at all — and note that --note is required for
# `blocked` before anything is compared, since the user is asserting the status
# whether or not it turns out to have moved (§18.2).
exec para set project acme-migration --name 'Acme migration'
cmp stdout $WORK/want-no-change.txt

# §26's own `log` line, run here rather than in read.txtar because this is where
# the change events are: a kind and a limit together, since either alone would
# leave the composition untested (§16.3).
exec para log project acme-migration --kind change --limit 3
stdout '  change  status planned → in-progress$'
stdout '  change  status in-progress → blocked  waiting on the ingest team$'
! stdout '  note  '

# type is fixed at creation and can never be changed (§15) — set's per-noun
# subcommand never registers the flag at all (P19.5), so this is now an
# unknown-flag refusal rather than a runtime one.
! exec para set key-result acme-migration.q1-growth.signups --type number
stderr 'unknown flag: --type'

# unset takes bare names; `created` is an error, and a required field is too.
exec para set project acme-migration --due 2026-12-31 --priority high
exec para unset project acme-migration due priority
stdout '^project.acme-migration  due unset \(was 2026-12-31\)\n'
! exec para unset project acme-migration created
stderr 'created cannot be unset'
! exec para unset project acme-migration name
stderr 'name is required'

# A due coarser than a full date is accepted too — a year or a year-month,
# each meaning by the end of that period (para-xbb). The write path used to
# gate the raw string on --at's own floor-at-a-full-date grammar before it
# ever reached ptime.Deadline's wider one, so this failed until normalise's
# own FieldDue case was pointed at Deadline instead.
exec para set project acme-migration --due 2027
grep 'due = "2027"' projects/acme-migration/.para/state.toml
exec para set project acme-migration --due 2027-04
grep 'due = "2027-04"' projects/acme-migration/.para/state.toml
exec para unset project acme-migration due

# `unset skill x scope` widens it back to the whole tree (§5.2, §15).
exec para unset skill signups-report scope
! grep 'When working under' .agents/rules/para-signups-report.md

# --- §26's `para note` / `measure` block ------------------------------------

exec para note area health.training 'swapped the tempo block for intervals'
grep 'Note: swapped the tempo block for intervals.' areas/health/training/ACTIVITY.md

# §26's measurement, with §4.2's arithmetic: start is subtracted from both
# sides, so 880/11000 against start 480/9000 and target 2000/12000 is 0.24.
# measure takes no noun (R13) — the chain alone always names a key-result.
exec para measure acme-migration.q1-growth.signups 880/11000 --at 2026-01-03
cmp stdout $WORK/want-measured.txt
cmp projects/acme-migration/objectives/q1-growth/key-results/signups/MEASUREMENTS.csv $WORK/want-measurements.txt

# The value follows the key-result's own type, and a mismatch names both.
! exec para measure acme-migration.q1-growth.signups 0.08
stderr 'value 0.08 is not a ratio \(type ratio expects <numerator>/<denominator>\)'

# Measurements are unique at the exact stored instant, not the day (§3.1).
! exec para measure acme-migration.q1-growth.signups 900/11000 --at 2026-01-03
stderr 'a measurement already exists at 2026-01-03T08:00:00Z \(2026-01-03T00:00:00-08:00 local\)'
exec para measure acme-migration.q1-growth.signups 900/11000 --at 2026-01-03T09:02

# Nothing may be dated into the future (§15.1).
! exec para note area health 'later'  --at 2027-01-01
stderr 'in the future'

# --- §26/§28's `para suppress` / `unsuppress` block -------------------------

exec para suppress project acme-migration --until 2027-03-01 --note 'paused, resumes with Q1 relaunch'
cmp stdout $WORK/want-suppressed.txt
grep '\[suppression\]' projects/acme-migration/.para/state.toml
grep 'until = "2027-03-01"' projects/acme-migration/.para/state.toml
grep 'Suppressed until 2027-03-01 — paused, resumes with Q1 relaunch\.' projects/acme-migration/ACTIVITY.md

# --until and --note are both required (§18.7, §28.2), same rule §18.2
# already applies to `blocked`.
! exec para suppress project acme-migration --note x
stderr '^error: --until is required for suppress$'
! exec para suppress project acme-migration --until 2027-03-01
stderr '^error: --note is required for suppress$'

# unsuppress is the same event kind with until empty (§28.2) — no second kind,
# nothing to delete.
exec para unsuppress project acme-migration --note 'relaunch moved up'
cmp stdout $WORK/want-unsuppressed.txt
! grep '\[suppression\]' projects/acme-migration/.para/state.toml

! exec para unsuppress project acme-migration
stderr '^error: --note is required for unsuppress$'

# Only a key-result takes measurements (§4.4: it lives there and nowhere
# else) — since measure always resolves its bare chain against key-result's
# own arity (R13), a chain of the wrong length is now the arity refusal
# rather than a kind-mismatch one.
! exec para measure acme-migration 10
stderr 'key-result takes exactly three segments, not a chain of 1'

# A mutation needs a tree.
cd $WORK/outside
! exec para add project x --name X --description Y
stderr 'no para tree found'

-- brain/.para/tree.toml --
schema = 1
name = "brain"

-- brain/README.md --
---
kind: "tree"
name: "brain"
---

