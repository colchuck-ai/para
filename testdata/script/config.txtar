# §26's `para config` block, against a hand-planted tree. The tree is planted
# by this script rather than by `para init`, whose full file set is a later
# phase's job (§0.1).
#
# One departure from §26, deliberate: the block shows `config set --at …`
# printing nothing at all, while §23 says mutations print what they wrote, one
# line per file. The prose wins — a `set` that writes a file and says nothing
# is the one case where a user cannot tell whether --at landed where they meant.
#
# Since Phase 8 a config change is also an event in that level's own journal
# (§8.1), so the file list is three lines rather than one, and the clock has to
# be fixed for the journal filename to be assertable at all (§0.2).

env PARA_NOW=2026-03-05T17:00:00Z
env PARA_TZ=America/Los_Angeles

# The chain is built deliberately, one level at a time (§22).
cd brain
exec para config set --at projects project.stale-after 30
cmp stdout $WORK/want-set-projects.txt

# The change is recorded where it happened (§3.2, §8.1), and reads as a
# sentence in that level's own digest.
grep '"kind":"change","field":"project.stale-after","to":"30"' projects/.para/logs/20260305T170000Z.jsonl
grep 'Set \*\*project\.stale-after\*\* to 30' projects/ACTIVITY.md

# §22's worked example, byte for byte: the resolved value, then every level
# consulted, nearest first, with the winner marked.
exec para config show project.stale-after projects.acme-migration
cmp stdout $WORK/want-chain.txt

# The written file holds exactly the key that was set.
cmp projects/.para/config.toml $WORK/want-projects-config.txt

# Resolution is nearest-wins, so the same key at the root is a different answer
# for anything outside projects/ (§7).
exec para config show project.stale-after
stdout '^14\n'

# A value set at a level, from inside that level's subtree, using "." (§14).
cd projects/acme-migration
exec para config set --at . project.stale-after 3
stdout '^ +projects/acme-migration/\.para/config\.toml\n'
exec para config show project.stale-after .
stdout '^3\n'
cd $WORK/brain

# emit.claude is the root's knob (§6.1), and what this section asserts is the
# config write alone. Its consequences — eight CLAUDE.md files and the
# .claude/skills mirror — land in the same command and are claude.txtar's, which
# is why this tree has no skills and so has no mirror to write.
exec para config set emit.claude true
stdout '^ +\.para/config\.toml\n'
grep '^emit\.claude = true$' .para/config.toml

# Setting a key to the value it already holds writes nothing and says so (§23).
exec para config set emit.claude true
stdout '^no change\n$'

# unset removes the value and resolution continues up the chain (§7).
exec para config unset --at projects project.stale-after
stdout '^ +projects/\.para/config\.toml\n'
grep 'Unset \*\*project\.stale-after\*\* \(was 30\)' projects/ACTIVITY.md
exec para config show project.stale-after projects.other-project
stdout '^14\n'

# A skill's chain is its own config.toml and then the root, with nothing in
# between, because .agents/ is not in the PARA tree (§7).
exec para config set --at skills.signups-report review.cadence 90
stdout '^ +\.agents/skills/para-signups-report/\.para/config\.toml\n'
exec para config show review.cadence skills.signups-report
cmp stdout $WORK/want-skill-chain.txt

# `config list` names every knob para reads and where each value came from.
exec para config list --prefix emit
stdout 'emit\.claude +true +<root>'
stdout 'emit\.claude-skills +symlink +\(default\)'
! stdout 'stale-after'

# Refusals. A key para does not read is a knob the user would believe in
# forever, so a typo is refused rather than written.
! exec para config set project.stale-aftr 30
stderr 'unknown config key'
! exec para config set project.stale-after soon
stderr 'whole number'
! exec para config set emit.claude-skills hardlink
stderr 'symlink, copy'
! exec para config set --at projects.nope project.stale-after 30
stderr 'projects.nope does not exist'

# Config is a property of a tree, so every config command needs one.
cd $WORK/outside
! exec para config list
stderr 'no para tree found'

-- brain/.para/tree.toml --
schema = 1

-- brain/.para/config.toml --
project.stale-after = 14

-- brain/projects/.para/state.toml --
name = "Projects"

-- brain/projects/acme-migration/.para/state.toml --
name = "Acme migration"

-- brain/projects/other-project/.para/state.toml --
name = "Other project"

-- brain/.agents/skills/para-signups-report/.para/state.toml --
name = "Signups report"

-- want-chain.txt --
30

  project.acme-migration      —
→ project                     30
  <root>                      14
-- want-set-projects.txt --
wrote  projects/.para/logs/20260305T170000Z.jsonl
       projects/.para/config.toml
       projects/ACTIVITY.md
-- want-projects-config.txt --
project.stale-after = 30
-- want-skill-chain.txt --
90

→ skill.signups-report      90
  <root>                    —
-- outside/.keep --
not a para tree
