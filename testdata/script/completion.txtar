# Shell completions (implementation plan, Phase 21).
#
# §26 has no completion block, and §13 has no completion verb — this is the one
# command in the tree that is about typing rather than about the model. It earns
# its place on the address (R1): a noun at position 0, an id-chain at position 1,
# every segment of which para already knows, and a mistyped one is an error
# rather than a near miss.
#
# What is asserted here is the *candidate sets*, not the shell scripts, because
# the candidate sets are para's and the scripts are cobra's. The rule each set
# follows is R12's table of what each verb accepts, which is the same table
# every command validates its argument against — so a completion that offered
# something the verb refuses would be para disagreeing with itself.

env PARA_NOW=2026-03-05T17:00:00Z
env PARA_TZ=America/Los_Angeles

exec para init brain
cd brain
exec para add project acme --name Acme --description 'Rebuild the consumer.'
exec para add objective acme.q1-growth --name 'Grow signups' --description 'Move the top of the funnel.'
exec para add key-result acme.q1-growth.signups --name 'Weekly signups' --description 'Per week.' --type number --target 2000
exec para add area health --name Health --description 'Staying in one piece.'
exec para add area health.training --name Training --description 'Skills practice.'
exec para add area wellness --name Wellness --description 'Sleep and rest.'
exec para add area fitness --name Fitness --description 'Getting stronger.'
exec para add skill commit-style --name 'Commit style' --description 'when writing a commit message'
exec para archive area fitness

# fitness is now the one archived thing in the tree — every archived-side
# assertion below reads it, and only it.

# --- the three shells the plan names ----------------------------------------

exec para completion bash
stdout '__start_para'
exec para completion zsh
stdout '#compdef para'
exec para completion fish
stdout '__para_perform_completion'

# --- the noun position (task P21.2) -----------------------------------------

# `show` takes an entity or a container (R17), so all seven nouns are offered.
exec para __complete show ''
stdout '^project$'
stdout '^area$'
stdout '^key-result$'
stdout '^skill$'
stdout '^container$'

# `archive` is entity-only (R17): six nouns, never `container` — naming one is
# the error §13 spells out.
exec para __complete archive ''
stdout '^area$'
stdout '^key-result$'
! stdout '^container$'

# `add`, `set`, and `unset` dispatch to one subcommand per noun (R3), and cobra
# completes the subcommand names natively — `container` is never among them,
# because add.go's newNounDispatchCmd never registers one for it (R15).
exec para __complete add ''
stdout '^area\t'
stdout '^key-result\t'
stdout '^skill\t'
! stdout '^container'
exec para __complete set ''
stdout '^project\t'
! stdout '^container'
exec para __complete unset ''
stdout '^resource\t'
! stdout '^container'

# --- the chain position, narrowed by the noun already typed (task P21.3) ----

# `show project <TAB>` offers only project chains.
exec para __complete show project ''
stdout '^acme$'
! stdout '^health$'

# `show area <TAB>` offers every live area chain, nested ones included —
# and not the archived one, which stays out until --archived says otherwise.
exec para __complete show area ''
stdout '^health$'
stdout '^health.training$'
stdout '^wellness$'
! stdout '^fitness$'

# `note` is entity-only; a container is refused before a chain is even typed.
exec para __complete note ''
! stdout '^container$'

# `set key-result <TAB>` offers the one key-result there is.
exec para __complete set key-result ''
stdout '^acme.q1-growth.signups$'

# --- `add`'s own chain: parent places, not existing entities (task P21.3) ---

# `add key-result <TAB>` offers objective chains — the R1 decision log's own
# worked example — with a trailing dot and no space, so the new id can be
# typed right after. This is strictly better than the old completeAddParent,
# which offered every nesting place in the tree regardless of what was being
# created.
exec para __complete add key-result ''
stdout '^acme.q1-growth.$'
# The wrong parent (project's own chain, not the objective beneath it) would
# also carry the trailing dot, so the discriminating check is against that
# shape specifically, not the bare, dotless form nothing here ever produces.
! stdout '^acme\.$'
stdout ':6$'

# `add area <TAB>` offers every existing area chain to nest a new one under,
# to any depth — including the one that is itself already nested.
exec para __complete add area health.
stdout '^health.$'
stdout '^health.training.$'

# `add project <TAB>` has no parent to complete at all (R3: a project does
# not nest) — nothing is offered, silently. A wrong-parent bug here would
# leak some other noun's own chains, dotted the way every real add-chain
# candidate is, so the check is against that shape rather than the bare form
# nothing here would ever produce anyway.
exec para __complete add project ''
! stdout '^acme\.$'
! stdout '^health\.$'
! stdout '^wellness\.$'

# --- `move`'s second chain: the destination, not an existing entity ---------
# (task P21.4)

# `move area health <TAB>` offers the other live area as a destination, and
# excludes both the source itself and its own descendant — §18.3's "an entity
# cannot move inside itself".
exec para __complete move area health ''
stdout '^wellness.$'
! stdout '^health.$'
! stdout '^health.training.$'

# `move area fitness --archived <TAB>`: --archived means both ends are
# archived (R9), and fitness is the only thing there — so once it is excluded
# as its own source, nothing is left.
exec para __complete move area fitness --archived ''
! stdout '^fitness'
! stdout '^health'
! stdout '^wellness'

# --- `unset`'s field position, after the chain (§18.2) ----------------------

exec para __complete unset area health ''
stdout '^priority$'
stdout '^tags$'
# A field already named is not offered again.
exec para __complete unset area health tags ''
! stdout '^tags$'
stdout '^priority$'

# --- `list`'s own lookahead (R19, task P21.5) --------------------------------

# A lone noun position offers the six filterable kinds — `container` is
# never a legal filter (R20).
exec para __complete list ''
stdout '^key-result$'
! stdout '^container$'

# After one noun, the second position is genuinely ambiguous (R19's own
# lookahead) until it is typed in full, so both readings' candidates are
# offered together: every noun (for "first is a filter, second is a bucket
# scope") and the first noun's own chains (for "the pair is a scope").
exec para __complete list key-result ''
stdout '^project$'
stdout '^container$'
stdout '^acme.q1-growth.signups$'

# Once the second token *is* a noun, the third position narrows to its own
# chains — including a container's, which `list` accepts as a scope even
# though it refuses one as a filter.
exec para __complete list key-result project ''
stdout '^acme$'
exec para __complete list key-result container ''
stdout '^acme.objectives$'
stdout '^acme.q1-growth.key-results$'

# `container` at position 0 can never play the kind-filter role (R20), so —
# unlike every other noun — the second position offers only its own chains,
# never a second noun: `list container project …` is refused outright by
# parseListArgs no matter what follows, so offering `project` there would be
# a candidate the verb is guaranteed to refuse.
exec para __complete list container ''
stdout '^acme.objectives$'
stdout '^acme.q1-growth.key-results$'
! stdout '^project$'
! stdout '^key-result$'

# ...and the third position, reachable only by hand-typing a noun there
# anyway, offers nothing rather than a chain that leads to the same refusal.
exec para __complete list container project ''
! stdout '^acme$'

# --- `--archived` flips the candidate set (task P21.6) ----------------------

exec para __complete show area --archived ''
stdout '^fitness$'
! stdout '^health$'
! stdout '^wellness$'

# --- `--scope` and `config --at` complete dotted addresses (R24, task P21.7)

exec para __complete add skill x --scope ''
stdout '^project.acme$'
stdout '^objective.acme.q1-growth$'
stdout '^key-result.acme.q1-growth.signups$'
stdout '^skill.commit-style$'
stdout '^archive.area.fitness$'

# A second entry, after a comma, keeps the first verbatim and completes only
# the part being typed.
exec para __complete add skill x --scope project.acme,area.h
stdout '^project.acme,area.health$'

exec para __complete config set stale-after --at ''
stdout '^project.acme$'
stdout '^area.health$'

exec para __complete config show stale-after ''
stdout '^project.acme$'

# --- the value/filter split, now per-noun (R29, task P21.8) -----------------

# A key-result's own `--status` offers only `dropped` — the one settable
# value carved out of a derived field (§4.3) — with no other kind's
# vocabulary leaking in, and no special case written for it.
exec para __complete add key-result acme.q1-growth --status ''
stdout '^dropped$'
! stdout '^blocked$'

# `list`'s `--status` is the *filter* role instead: effective status, which
# reaches values no kind's own value vocabulary offers on its own, such as a
# key-result's derived `at-risk`.
exec para __complete list --status ''
stdout '^at-risk$'

# area has no status field at all (§15) — add never registers the flag, so
# there is nothing to complete and nothing to fall back to filenames either.
! exec para add area x --status planned
stderr 'unknown flag'
